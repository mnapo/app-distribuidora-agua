generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model AppMetadata {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_metadata")
}

model Tenant {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  settings  TenantSetting?
  users     User[]
  roles     Role[]
  auditLogs AuditLog[]
  branches  Branch[]
  warehouses Warehouse[]
  customers Customer[]
  productCategories ProductCategory[]
  products Product[]
  priceLists PriceList[]
  vehicles Vehicle[]
  drivers Driver[]
  inventory Inventory[]
  inventoryMovements InventoryMovement[]
  orders Order[]
  orderItems OrderItem[]
  orderHistories OrderHistory[]
  deliveryRoutes DeliveryRoute[]
  deliveryRouteOrders DeliveryRouteOrder[]
  deliveryRouteHistories DeliveryRouteHistory[]
  deliveryStopItems DeliveryStopItem[]
  deliveryEvidences DeliveryEvidence[]
  offlineSyncOperations OfflineSyncOperation[]
  containerTypes ContainerType[]
  containerMovements ContainerMovement[]
  customerContainerBalances CustomerContainerBalance[]
  invoices Invoice[]
  invoiceItems InvoiceItem[]
  payments Payment[]
  paymentAllocations PaymentAllocation[]
  accountMovements AccountMovement[]
  cashClosings CashClosing[]
  recurringOrderRules RecurringOrderRule[]
  recurringOrderExceptions RecurringOrderException[]
  subscriptionPlans SubscriptionPlan[]
  subscriptionPlanItems SubscriptionPlanItem[]
  customerSubscriptions CustomerSubscription[]
  subscriptionUsages SubscriptionUsage[]
  dispenserModels DispenserModel[]
  dispensers Dispenser[]
  dispenserComodatos DispenserComodato[]
  dispenserMovements DispenserMovement[]
  dispenserMaintenances DispenserMaintenance[]
  alertRules AlertRule[]
  alerts Alert[]
  notifications Notification[]
  scheduledTasks ScheduledTask[]
  externalIntegrations ExternalIntegration[]
  webhookEndpoints WebhookEndpoint[]
  integrationEvents IntegrationEvent[]
  publicApiKeys PublicApiKey[]

  @@index([status])
  @@map("tenants")
}

model TenantSetting {
  id                       String   @id @default(cuid())
  tenantId                 String   @unique @map("tenant_id")
  allowNegativeStock        Boolean  @default(false) @map("allow_negative_stock")
  usesReturnableContainers  Boolean  @default(true) @map("uses_returnable_containers")
  usesDispensers            Boolean  @default(false) @map("uses_dispensers")
  usesSubscriptions         Boolean  @default(false) @map("uses_subscriptions")
  gpsMode                   GpsMode  @default(OPTIONAL) @map("gps_mode")
  requiresSignature         Boolean  @default(false) @map("requires_signature")
  deliveryPhotoMode         PhotoMode @default(OPTIONAL) @map("delivery_photo_mode")
  allowDeliveryQuantityChanges Boolean @default(true) @map("allow_delivery_quantity_changes")
  allowMobileAdditionalSales Boolean @default(false) @map("allow_mobile_additional_sales")
  currency                  String   @default("ARS")
  timezone                  String   @default("America/Argentina/Buenos_Aires")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

model User {
  id              String     @id @default(cuid())
  tenantId        String?    @map("tenant_id")
  email           String
  passwordHash    String     @map("password_hash")
  firstName       String     @map("first_name")
  lastName        String     @map("last_name")
  status          UserStatus @default(ACTIVE)
  isPlatformAdmin Boolean    @default(false) @map("is_platform_admin")
  lastLoginAt     DateTime?  @map("last_login_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  tenant        Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userRoles     UserRole[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  driver        Driver?
  inventoryMovements InventoryMovement[]
  createdOrders Order[] @relation("OrderCreatedBy")
  orderHistories OrderHistory[]
  deliveryRouteHistories DeliveryRouteHistory[]
  offlineSyncOperations OfflineSyncOperation[]

  @@unique([email])
  @@index([tenantId, status])
  @@map("users")
}

model RefreshToken {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  replacedBy  String?   @map("replaced_by")
  ip          String?
  userAgent   String?   @map("user_agent")
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Role {
  id          String   @id @default(cuid())
  tenantId    String?  @map("tenant_id")
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String?  @map("tenant_id")
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  oldValues Json?    @map("old_values")
  newValues Json?    @map("new_values")
  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

model Branch {
  id        String       @id @default(cuid())
  tenantId  String       @map("tenant_id")
  name      String
  code      String?
  address   String?
  phone     String?
  active    Boolean      @default(true)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouses Warehouse[]

  @@unique([tenantId, name])
  @@unique([tenantId, code])
  @@index([tenantId, active])
  @@map("branches")
}

model Warehouse {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  branchId  String?  @map("branch_id")
  name      String
  code      String?
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  inventory Inventory[]
  inventoryMovementsFrom InventoryMovement[] @relation("InventoryMovementFromWarehouse")
  inventoryMovementsTo InventoryMovement[] @relation("InventoryMovementToWarehouse")
  deliveryRoutes DeliveryRoute[]

  @@unique([tenantId, name])
  @@unique([tenantId, code])
  @@index([tenantId, active])
  @@index([tenantId, branchId])
  @@map("warehouses")
}

model Customer {
  id              String         @id @default(cuid())
  tenantId        String         @map("tenant_id")
  type            CustomerType   @default(PERSON)
  businessName    String?        @map("business_name")
  firstName       String?        @map("first_name")
  lastName        String?        @map("last_name")
  taxId           String?        @map("tax_id")
  phone           String?
  email           String?
  creditLimit     Decimal        @default(0) @map("credit_limit") @db.Decimal(12, 2)
  paymentTerms    String?        @map("payment_terms")
  priceListId     String?        @map("price_list_id")
  status          CustomerStatus @default(ACTIVE)
  notes           String?
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  priceList PriceList? @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  addresses CustomerAddress[]
  customerProductPrices CustomerProductPrice[]
  orders Order[]
  containerMovements ContainerMovement[]
  containerBalances CustomerContainerBalance[]
  invoices Invoice[]
  payments Payment[]
  accountMovements AccountMovement[]
  recurringOrderRules RecurringOrderRule[]
  recurringOrderExceptions RecurringOrderException[]
  customerSubscriptions CustomerSubscription[]
  subscriptionUsages SubscriptionUsage[]
  currentDispensers Dispenser[]
  dispenserComodatos DispenserComodato[]
  dispenserMovements DispenserMovement[]
  dispenserMaintenances DispenserMaintenance[]

  @@index([tenantId, status])
  @@index([tenantId, taxId])
  @@index([tenantId, priceListId])
  @@map("customers")
}

model CustomerAddress {
  id               String   @id @default(cuid())
  tenantId         String   @map("tenant_id")
  customerId       String   @map("customer_id")
  street           String
  streetNumber     String?  @map("street_number")
  city             String?
  province         String?
  postalCode       String?  @map("postal_code")
  latitude         Decimal? @db.Decimal(10, 7)
  longitude        Decimal? @db.Decimal(10, 7)
  reference        String?
  deliveryNotes    String?  @map("delivery_notes")
  contactName      String?  @map("contact_name")
  contactPhone     String?  @map("contact_phone")
  isPrimary        Boolean  @default(false) @map("is_primary")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orders Order[]
  recurringOrderRules RecurringOrderRule[]

  @@index([tenantId, customerId])
  @@index([tenantId, isPrimary])
  @@map("customer_addresses")
}

model ProductCategory {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, name])
  @@index([tenantId, active])
  @@map("product_categories")
}

model Product {
  id               String   @id @default(cuid())
  tenantId         String   @map("tenant_id")
  sku              String
  barcode          String?
  name             String
  description      String?
  categoryId       String?  @map("category_id")
  unit             String
  liters           Decimal? @db.Decimal(10, 2)
  cost             Decimal  @default(0) @db.Decimal(12, 2)
  price            Decimal  @default(0) @db.Decimal(12, 2)
  tax              Decimal  @default(0) @db.Decimal(5, 2)
  active           Boolean  @default(true)
  returnable       Boolean  @default(false)
  requiresContainer Boolean @default(false) @map("requires_container")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  priceListItems PriceListItem[]
  customerProductPrices CustomerProductPrice[]
  inventory Inventory[]
  inventoryMovements InventoryMovement[]
  orderItems OrderItem[]
  deliveryStopItems DeliveryStopItem[]
  recurringOrderRuleItems RecurringOrderRuleItem[]
  subscriptionPlanItems SubscriptionPlanItem[]
  subscriptionUsages SubscriptionUsage[]

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([tenantId, active])
  @@index([tenantId, categoryId])
  @@map("products")
}

model Vehicle {
  id                         String        @id @default(cuid())
  tenantId                   String        @map("tenant_id")
  plate                      String
  brand                      String?
  model                      String?
  year                       Int?
  capacity                   Decimal?      @db.Decimal(12, 2)
  capacityUnit               String        @default("unidad") @map("capacity_unit")
  status                     VehicleStatus @default(ACTIVE)
  insuranceExpiresAt          DateTime?     @map("insurance_expires_at")
  documentationExpiresAt      DateTime?     @map("documentation_expires_at")
  technicalInspectionExpiresAt DateTime?    @map("technical_inspection_expires_at")
  createdAt                  DateTime      @default(now()) @map("created_at")
  updatedAt                  DateTime      @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inventory Inventory[]
  inventoryMovements InventoryMovement[]
  assignedOrders Order[] @relation("OrderAssignedVehicle")
  deliveryRoutes DeliveryRoute[]

  @@unique([tenantId, plate])
  @@index([tenantId, status])
  @@map("vehicles")
}

model Driver {
  id               String       @id @default(cuid())
  tenantId         String       @map("tenant_id")
  userId           String       @unique @map("user_id")
  licenseNumber    String?      @map("license_number")
  licenseCategory  String?      @map("license_category")
  licenseExpiresAt DateTime?    @map("license_expires_at")
  status           DriverStatus @default(ACTIVE)
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedOrders Order[] @relation("OrderAssignedDriver")
  deliveryRoutes DeliveryRoute[]

  @@index([tenantId, status])
  @@map("drivers")
}

model Inventory {
  id          String            @id @default(cuid())
  tenantId    String            @map("tenant_id")
  productId   String            @map("product_id")
  warehouseId String?           @map("warehouse_id")
  vehicleId   String?           @map("vehicle_id")
  quantity    Decimal           @default(0) @db.Decimal(14, 3)
  locationType InventoryLocation @map("location_type")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([tenantId, productId, warehouseId, vehicleId])
  @@index([tenantId, productId])
  @@index([tenantId, warehouseId])
  @@index([tenantId, vehicleId])
  @@map("inventory")
}

model InventoryMovement {
  id              String                @id @default(cuid())
  tenantId        String                @map("tenant_id")
  productId       String                @map("product_id")
  type            InventoryMovementType
  quantity        Decimal               @db.Decimal(14, 3)
  fromWarehouseId String?               @map("from_warehouse_id")
  toWarehouseId   String?               @map("to_warehouse_id")
  vehicleId       String?               @map("vehicle_id")
  userId          String?               @map("user_id")
  reason          String?
  reference       String?
  createdAt       DateTime              @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  fromWarehouse Warehouse? @relation("InventoryMovementFromWarehouse", fields: [fromWarehouseId], references: [id], onDelete: SetNull)
  toWarehouse Warehouse? @relation("InventoryMovementToWarehouse", fields: [toWarehouseId], references: [id], onDelete: SetNull)
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, productId])
  @@index([tenantId, type])
  @@index([tenantId, createdAt])
  @@index([tenantId, fromWarehouseId])
  @@index([tenantId, vehicleId])
  @@map("inventory_movements")
}

model PriceList {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  name      String
  active    Boolean  @default(true)
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customers Customer[]
  items PriceListItem[]

  @@unique([tenantId, name])
  @@index([tenantId, active])
  @@map("price_lists")
}

model PriceListItem {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  priceListId String   @map("price_list_id")
  productId   String   @map("product_id")
  price       Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([priceListId, productId])
  @@index([tenantId, priceListId])
  @@index([tenantId, productId])
  @@map("price_list_items")
}

model CustomerProductPrice {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  customerId String   @map("customer_id")
  productId  String   @map("product_id")
  price      Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
  @@index([tenantId, customerId])
  @@index([tenantId, productId])
  @@map("customer_product_prices")
}

model Order {
  id                  String      @id @default(cuid())
  tenantId            String      @map("tenant_id")
  number              Int
  customerId          String      @map("customer_id")
  deliveryAddressId   String?     @map("delivery_address_id")
  assignedDriverId    String?     @map("assigned_driver_id")
  assignedVehicleId   String?     @map("assigned_vehicle_id")
  createdById         String?     @map("created_by_id")
  status              OrderStatus @default(DRAFT)
  requestedDeliveryAt DateTime?   @map("requested_delivery_at")
  deliveryStreet      String?     @map("delivery_street")
  deliveryStreetNumber String?    @map("delivery_street_number")
  deliveryCity        String?     @map("delivery_city")
  deliveryProvince    String?     @map("delivery_province")
  deliveryPostalCode  String?     @map("delivery_postal_code")
  deliveryReference   String?     @map("delivery_reference")
  deliveryNotes       String?     @map("delivery_notes")
  subtotal            Decimal     @default(0) @db.Decimal(12, 2)
  discountTotal       Decimal     @default(0) @map("discount_total") @db.Decimal(12, 2)
  total               Decimal     @default(0) @db.Decimal(12, 2)
  notes               String?
  cancelReason        String?     @map("cancel_reason")
  confirmedAt         DateTime?   @map("confirmed_at")
  assignedAt          DateTime?   @map("assigned_at")
  cancelledAt         DateTime?   @map("cancelled_at")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  deliveryAddress CustomerAddress? @relation(fields: [deliveryAddressId], references: [id], onDelete: SetNull)
  assignedDriver Driver? @relation("OrderAssignedDriver", fields: [assignedDriverId], references: [id], onDelete: SetNull)
  assignedVehicle Vehicle? @relation("OrderAssignedVehicle", fields: [assignedVehicleId], references: [id], onDelete: SetNull)
  createdBy User? @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items OrderItem[]
  history OrderHistory[]
  routeAssignments DeliveryRouteOrder[]
  invoices Invoice[]
  accountMovements AccountMovement[]
  recurringRuleGenerated RecurringOrderGenerated?

  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, requestedDeliveryAt])
  @@index([tenantId, assignedDriverId])
  @@unique([tenantId, number])
  @@map("orders")
}

model OrderItem {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  orderId       String   @map("order_id")
  productId     String   @map("product_id")
  quantity      Decimal  @db.Decimal(14, 3)
  unitPrice     Decimal  @map("unit_price") @db.Decimal(12, 2)
  discount      Decimal  @default(0) @db.Decimal(12, 2)
  lineSubtotal  Decimal  @map("line_subtotal") @db.Decimal(12, 2)
  lineTotal     Decimal  @map("line_total") @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([tenantId, orderId])
  @@index([tenantId, productId])
  @@map("order_items")
}

model OrderHistory {
  id        String      @id @default(cuid())
  tenantId  String      @map("tenant_id")
  orderId   String      @map("order_id")
  userId    String?     @map("user_id")
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus   @map("to_status")
  action    String
  notes     String?
  createdAt DateTime    @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, orderId])
  @@index([tenantId, createdAt])
  @@map("order_history")
}

model DeliveryRoute {
  id            String              @id @default(cuid())
  tenantId      String              @map("tenant_id")
  name          String
  routeDate     DateTime            @map("route_date")
  warehouseId   String              @map("warehouse_id")
  driverId      String              @map("driver_id")
  vehicleId     String              @map("vehicle_id")
  status        DeliveryRouteStatus @default(DRAFT)
  notes         String?
  preparedAt    DateTime?           @map("prepared_at")
  loadedAt      DateTime?           @map("loaded_at")
  closedAt      DateTime?           @map("closed_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  driver Driver @relation(fields: [driverId], references: [id], onDelete: Restrict)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
