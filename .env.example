# Root reference file. Copy the app-specific examples when configuring locally.

# API
API_PORT=3001
API_HOST_PORT=3001
WEB_PORT=3000
# En Docker, si MySQL corre fuera de este compose pero publica el puerto en el host,
# usar host.docker.internal en lugar de localhost.
# Ejemplo: mysql://agua_user:agua_password@host.docker.internal:3306/agua_distri
DATABASE_URL="mysql://agua_user:agua_password@localhost:3306/agua_distri"
LOCAL_STORAGE_ROOT="./storage"
WEB_ORIGIN="http://localhost:3000"
JWT_ACCESS_SECRET="change-me-use-a-long-random-secret"
JWT_ACCESS_EXPIRES_IN="15m"
REFRESH_TOKEN_DAYS=7

# Web
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
